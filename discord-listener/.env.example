# Required: shared by the Unity game and this service. Use a long random value.
GAME_API_KEY=replace-with-a-long-random-secret

# The port this service listens on.
PORT=3000

# Direct Discord gateway mode. Enable the Message Content privileged intent in Discord's developer portal.
DISCORD_BOT_TOKEN=

# Optional: comma-separated list of Discord channel IDs that can answer hints.
DISCORD_ALLOWED_CHANNEL_IDS=

# Relay mode for an already-existing Discord bot. Its POSTs to /discord/messages use this value.
DISCORD_INGEST_KEY=
