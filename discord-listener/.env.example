# Required when running the listener manually. The Unity launcher supplies this
# value automatically when it starts the listener with the game.
GAME_API_KEY=replace-with-a-long-random-secret

# The port this service listens on.
API_PORT=3000

# Direct Discord gateway mode. Enable the Message Content privileged intent in Discord's developer portal.
DISCORD_BOT_TOKEN=

# Comma-separated list of Discord channel IDs that can answer hints. The Unity
# launcher supplies this from GameManager._channelIds when the game starts.
DISCORD_ALLOWED_CHANNEL_IDS=

# Legacy single-channel fallback, used only when DISCORD_ALLOWED_CHANNEL_IDS is unset.
DISCORD_CHANNEL_ID=

# Discord server (guild) ID. Not currently read by the listener; kept for reference.
DISCORD_GUILD_ID=
